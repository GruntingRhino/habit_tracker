[Unit]
Description=LiveImproved web (Next.js, localhost only)
After=network-online.target postgresql.service ollama.service
Wants=postgresql.service

[Service]
User=opc
WorkingDirectory=/home/opc/apps/liveimproved/web
EnvironmentFile=/etc/liveimproved.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/local/bin/liveimproved-node --max-old-space-size=384 server.js
Restart=always
RestartSec=3
MemoryMax=700M
Nice=5

[Install]
WantedBy=multi-user.target
