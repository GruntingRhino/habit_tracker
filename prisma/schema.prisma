generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  name          String?
  nutritionTargets Json?  // {calories, protein, carbs, fat} per day
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dailyEntries   DailyEntry[]
  categoryScores CategoryScore[]
  habits          Habit[]
  projects        Project[]
  notes           Note[]
  weightRoutines  WeightRoutine[]
  workoutSessions WorkoutSession[]
  meals           Meal[]
  chatMessages    ChatMessage[]
  conversations   Conversation[]
  todos           Todo[]
  reminders       Reminder[]
  dayPlans        DayPlan[]
}

model DailyEntry {
  id                      String   @id @default(cuid())
  userId                  String
  date                    DateTime
  sleepHours              Float?
  workoutCompleted        Boolean  @default(false)
  workoutDurationMinutes  Int?
  workoutIntensity        String?
  workoutDetails          String?
  sportsTrainingMinutes   Int?
  steps                   Int?
  deepWorkHours           Float?
  screenTimeHours         Float?
  tasksPlanned            Int?
  tasksCompleted          Int?
  taskDifficultyRating    Int?
  moneySpent              Float?
  moneySaved              Float?
  wakeTime                String?
  bedtime                 String?
  notes                   String?
  overallDayRating        Int?
  incomeActivity          Boolean  @default(false)
  workoutRoutineName      String?
  caloriesEaten           Int?
  rightWithGod            Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryScores CategoryScore[]

  @@unique([userId, date])
}

model CategoryScore {
  id          String     @id @default(cuid())
  userId      String
  dailyEntryId String?
  date        DateTime
  physical    Float      @default(0)
  financial   Float      @default(0)
  discipline  Float      @default(0)
  focus       Float      @default(0)
  mental      Float      @default(0)
  appearance  Float      @default(0)
  spiritual   Float      @default(0)
  work        Float      @default(0)
  overall     Float      @default(0)
  rationale   Json?
  journalScore    Int?
  journalFeedback String?
  judgedBy    String?
  finalized   Boolean    @default(false)
  createdAt   DateTime   @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyEntry  DailyEntry? @relation(fields: [dailyEntryId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  category  String   // breakfast, lunch, dinner, snack
  recipe    String?
  calories  Int?
  protein   Float?   // grams
  carbs     Float?   // grams
  fat       Float?   // grams
  items     Json?    // nutrition breakdown: [{name, amount, grams, calories, protein, carbs, fat, source}]
  nutritionSource String? // "ai" (estimated), "manual"
  micros    Json?    // meal totals: {sugar, fiber, sodium, potassium, magnesium, vitaminC, vitaminA, zinc, calcium, iron, vitaminD}
  sourceText String?  // what he wrote, so the estimate can be re-run with answered amounts
  servings  Int?     @default(1)
  notes     String?
  order     Int      @default(0)
  status    String   @default("saved") // saved (in rotation), planned, eaten
  plannedFor DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  category    String     @default("general")
  area        String     @default("general")
  timeOfDay   String     @default("any") // morning, evening, any
  targetDays  String[]   @default(["mon","tue","wed","thu","fri","sat","sun"])
  color       String     @default("#3b82f6")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  date        DateTime
  completed   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  title       String
  description String?
  specs       String?
  notes       String?
  priority    String        @default("medium")
  status      String        @default("active")
  area        String        @default("work")
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String?
  type      String   @default("note")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status, updatedAt])
}

model WeightRoutine {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   WeightExercise[]
  sessions    WorkoutSession[]
}

model WeightExercise {
  id         String               @id @default(cuid())
  routineId  String
  name       String
  descriptor String?
  order      Int                  @default(0)
  createdAt  DateTime             @default(now())

  routine    WeightRoutine        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  logs       WorkoutExerciseLog[]
}

model WorkoutSession {
  id           String               @id @default(cuid())
  userId       String
  routineId    String
  date         DateTime             @default(now())
  notes        String?
  createdAt    DateTime             @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine      WeightRoutine        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseLogs WorkoutExerciseLog[]
}

model WorkoutExerciseLog {
  id           String          @id @default(cuid())
  sessionId    String
  exerciseId   String?
  exerciseName String
  weight       Float?
  sets         Int?
  reps         String?
  notes        String?
  createdAt    DateTime        @default(now())

  session      WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise     WeightExercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
}

model ProjectTask {
  id               String        @id @default(cuid())
  projectId        String
  parentTaskId     String?
  title            String
  description      String?
  status           String        @default("todo")
  order            Int           @default(0)
  priority         String        @default("medium")
  area             String?
  estimatedMinutes Int?
  actualMinutes    Int?
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask       ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks         ProjectTask[] @relation("SubTasks")
}

model Conversation {
  id         String        @id @default(cuid())
  userId     String
  title      String        @default("New chat")
  saved      Boolean       @default(false) // starred: kept in history past 30 days
  source     String        @default("web") // web, telegram
  memory     String?       // compacted summary of turns older than memoryUpTo (~150 tokens)
  memoryUpTo DateTime?     // createdAt of the last message folded into memory
  plan       Json?         // goal-planning state: {goal, qa: [{q, a}], stage, plan}
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String        @id @default(cuid())
  userId         String
  conversationId String?
  role           String        // user, assistant
  content        String
  actions        Json?         // [{type, id, title, area}] items created by this turn (for undo + cards)
  awaiting       Json?         // pending clarifying question: {itemRefs: [...], question}
  meta           Json?         // UI extras: {options: [...]} quick replies, {plan: {...}} plan card
  source         String        @default("web") // web, telegram
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  title       String
  notes       String?
  area        String    @default("general") // physical, mental, financial, spiritual, work, general
  priority    String    @default("medium")  // low, medium, high, urgent
  status      String    @default("open")    // open, done
  dueAt       DateTime?
  completedAt DateTime?
  source      String    @default("web")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders   Reminder[]

  @@index([userId, status, dueAt])
}

model Reminder {
  id                String    @id @default(cuid())
  userId            String
  text              String
  fireAt            DateTime
  recurrence        String    @default("none") // none, daily, weekdays, weekly
  status            String    @default("pending") // pending, sent, done, cancelled
  todoId            String?
  telegramMessageId Int?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  todo              Todo?     @relation(fields: [todoId], references: [id], onDelete: SetNull)

  @@index([status, fireAt])
}

model DayPlan {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // local midnight of the planned day, stored as UTC date
  items       Json     // [{type, id, title, area, reason}]
  summary     String?
  model       String?
  generatedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

